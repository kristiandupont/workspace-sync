{
  "name": "workspace-sync",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.cjs",
  "exports": {
    ".":          { "require": "./dist/index.cjs",    "default": "./dist/index.cjs",    "types": "./dist/index.d.cts" },
    "./backend":  { "require": "./dist/backend.cjs",  "default": "./dist/backend.cjs",  "types": "./dist/backend.d.cts" },
    "./frontend": { "require": "./dist/frontend.cjs", "default": "./dist/frontend.cjs", "types": "./dist/frontend.d.cts" },
    "./kanel":    { "require": "./kanel/index.js",    "default": "./kanel/index.js",    "types": "./kanel/WorkspaceConfig.d.ts" }
  },
  "typesVersions": {
    "*": {
      "backend":  ["dist/backend.d.cts"],
      "frontend": ["dist/frontend.d.cts"]
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=3"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "kanel": "^4.0.0",
    "react": "^19.2.6",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^3.21.4"
  }
}
